# Copy this file to `.env` and fill in the values.
# NEVER commit the `.env` file (it is already in .gitignore).

# PetKit credentials — use a DEDICATED account, not the one from the phone
# app (PetKit allows a single active session per account: sharing it causes
# the bridge to be logged out repeatedly).
PETKIT_USERNAME=email@example.com
PETKIT_PASSWORD=changeme

# Region and timezone of the PetKit account
PETKIT_REGION=IT
PETKIT_TIMEZONE=Europe/Rome

# Static token protecting the bridge's local API.
# Generate a strong one, e.g. with: openssl rand -hex 32
BRIDGE_TOKEN=changeme

# HTTP server bind
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8787

# Background refresh interval (seconds)
PETKIT_REFRESH_INTERVAL=60

# --- Resilience (optional, sensible defaults) ---
# Consecutive refresh failures before forcing a full re-login
PETKIT_RELOGIN_AFTER=3
# Cap (seconds) of the exponential backoff between retries
PETKIT_MAX_BACKOFF=300
# 1 = crash the container if the initial login fails (default 0: start in
# degraded state and let the background task keep retrying)
PETKIT_FATAL_ON_START_FAIL=0

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
